# Database connection URL (SQLAlchemy format).
# Leave unset or empty to use the default local SQLite file (nexprice.db).
DB_URL=sqlite:///nexprice.db

# PostgreSQL (install with: pip install -e ".[postgres]")
# DB_URL=postgresql+psycopg://nexprice:changeme@localhost:5432/nexprice

# MySQL / MariaDB (install with: pip install -e ".[mysql]")
# DB_URL=mysql+pymysql://nexprice:changeme@localhost:3306/nexprice

# Microsoft SQL Server via ODBC (install with: pip install -e ".[mssql]")
# DB_URL=mssql+pyodbc://sa:changeme@localhost:1433/nexprice?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
